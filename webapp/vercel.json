{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/data/manifest.json",
      "headers": [{"key": "Cache-Control", "value": "public, max-age=0, must-revalidate"}]
    },
    {
      "source": "/data/(.*).geojson",
      "headers": [{"key": "Cache-Control", "value": "public, max-age=3600, s-maxage=86400"}]
    }
  ]
}
